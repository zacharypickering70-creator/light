extends RefCounted

const NAMES=["忘川埠","孟婆茶棚","寄名摊","残籍巷","回声渡","照魂碑","判影台"]
const FRAGMENTS={
3:"陆判批注：这些名字并未死去，只是被借走了回家的位置。愿境每续一夜，旧籍便多一道重笔。查的是偷名之契，不是求生之人。",
5:"陆照川手札：洪水退后，我把徒弟残存的一缕魂寄入灯中。本想借一夜等他醒来，却一夜夜借下去。那孩子只记得竹林里的家，不记得自己为何总能回来。"}

static func pages(ending: bool, remembered: int, released: int) -> Array:
	if not ending:
		return [
			{"title":"卷三 · 忘川旧市　｜　灯照无名","text":"听愿祠的引路签，在水边显出另一行字：先问来人姓名，再问他愿往何处。\n旧市的摊主仍摆着碗、鞋与家书，却答不出自己是谁。河灯顺流而下，照见灯底一层层被涂去的名字。\n师父要保住的那个孩子，究竟是谁？"},
			{"title":"孟婆 · 这一碗，由你自己端","text":"孟婆把汤放在桌上：忘记不是过错，记得也不是欠债。我只备汤，不替人举碗。\n自由探索旧市，可在寄名摊、回声渡帮助亡魂作出自己的选择；残籍巷和照魂碑留有师父与陆判的文字。\n杀怪升级。本境升六级或经过六分钟，无名判影现身。击败它，取回被愿契压住的名册。"}]
	return [
		{"title":"卷三终 · 簿上重名","text":"判影散成墨点，露出压在最后一页的名字。那字迹与你写在竹林门楣上的，一模一样。\n陆判合上残籍：借别人归途续你的命，是那张契的错。你既已知情，接下来往哪里走，才是你的事。\n原来师父手札里的孩子，一直是你。"},
		{"title":"孟婆 · 把碗放下以后","text":"你望着孟婆的汤。她没有催促。\n你说：先留着吧。这回，我想记得自己为什么出门。\n这一程，你陪 %d 位亡魂留下记忆，尊重 %d 位亡魂放下旧痛。两条路都有人需要，没有人的选择该被抹去。"%[remembered,released]},
		{"title":"陆判引路 · 华山照影","text":"陆判交来一封旧信：若我又不肯收手，请持此信往华山，求天眼照见灯中真相。落款仍是陆照川。\n你曾只想带师父回家。如今，你要问他：我们的家，可不可以不再建在别人的归路上？\n眼下，灯光仍照向旧市深处。你可以携香火归家，也可继续深入更危险的愿境。"}]

static func last_words(chapter: int) -> Array:
	match chapter:
		1: return [
			["缚舟","绳断了……我若不在岸边，她回来时，会不会找不到我？"],
			["提灯人","我替你把灯留下。想等，就等；可他们该过河了。"],
			["缚舟","……是啊。我从前，是送人过河的。上游那张愿签，别再替我求了。"]]
		2: return [
			["百愿娘娘","我听过太多哭声。我只是想，让他们再也不必求人……"],
			["提灯人","可他们连拒绝你，都做不到了。"],
			["百愿娘娘","原来他们还愿意哭……陆照川也曾这样劝我。后来，他把自己的愿写得比谁都深。去问他，灯中留的是谁。"]]
		3: return [
			["无名判影","你这一笔……我抄过。你的招式，你的归途，还有你一次次醒来的名字。"],
			["提灯人","那些被划去的人，是谁？"],
			["无名判影","被借了位置的人。我是被重写的名字，挤在一起的影。师父要救的孩子……就在你提着的灯里。"],
			["提灯人","那我活着，就只能让别人无处可去？"],
			["无名判影","别再问灯许你什么……问问那些人，愿不愿意。把名字……还给他们。"]]
		_: return [["愿影","旧愿还在水底……灯过之处，别再留下空名。"],["提灯人","这一程，我会记着。"]]
